# =========================================================
# Unreal Engine 5 project (BoxingHawkEyeSceneCreator)
# =========================================================

# --- Generated / cache folders (re-created by the editor) ---
/Binaries/
/Build/
/DerivedDataCache/
/Intermediate/
/Saved/
/Claude outputs/

# Plugin build outputs
#  - Intermediate は常に除外
#  - Binaries は Win64 の DLL / .modules だけ共有（Visual Studio なしでも開けるように）
Plugins/*/Intermediate/
Plugins/*/Binaries/*
!Plugins/*/Binaries/Win64/
Plugins/*/Binaries/Win64/*
!Plugins/*/Binaries/Win64/*.dll
!Plugins/*/Binaries/Win64/*.modules

# --- Hawk-Eye frame data (共有しない：各自 Data/HawkEye に配置) ---
/Data/HawkEye/*
!/Data/HawkEye/README.md

# --- IDE / solution files (regenerated by "Generate Project Files") ---
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/
.vscode/
.idea/
*.code-workspace

# --- Compiled / debug outputs ---
*.pdb
*.o
*.lib
*.exp
*.ilk
*.exe
*.so
*.dylib
*.app
*.ipa
*.target

# --- Packaging output ---
/Packaged/
/Releases/
*.pak
*.ucas
*.utoc

# --- Editor temp / crash files ---
*.tmp
*.log
*.dmp
/Content/Developers/
/Content/Collections/
__pycache__/
*.pyc

# --- OS / sync clutter ---
Thumbs.db
desktop.ini
.DS_Store
~$*
