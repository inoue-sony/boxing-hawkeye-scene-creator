#include "HUMAClothBindAsset.h"
#include "HUMAClothNativeBake.h"
#include "Misc/AutomationTest.h"
#include "Misc/CommandLine.h"
#include "Misc/Parse.h"
#include "Serialization/JsonReader.h"

IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHUMAClothBodyFieldGPUCountTest, "HUMAClothBind.GPU.BodyFieldMGreaterN",
    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
bool FHUMAClothBodyFieldGPUCountTest::RunTest(const FString&)
{
    if (GUsingNullRHI) { AddError(TEXT("This test requires a real RHI, not -NullRHI.")); return false; }
    FString Path, Text, Error;
    TSharedPtr<FJsonObject> Root;
    if (!FParse::Value(FCommandLine::Get(), TEXT("HUMAFieldFixture="), Path) ||
        !FFileHelper::LoadFileToString(Text, *Path) ||
        !FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Text), Root))
    { AddError(TEXT("Supply a valid -HUMAFieldFixture generated by tests/ue/body_field_parity.py.")); return false; }
    bool Tested = false;
    for (const auto& Value : Root->GetArrayField(TEXT("cases")))
    {
        const auto Input = Value->AsObject();
        if (!Input->HasField(TEXT("require_m_gt_n"))) continue;
        Tested = true;
        auto* Asset = NewObject<UHUMAClothBindAsset>();
        Asset->FormatVersion = 1;
        auto ReadVectors = [&](const TSharedPtr<FJsonObject>& Object, const TCHAR* Name)
        {
            TArray<FVector> Result;
            for (const auto& Item : Object->GetArrayField(Name))
            {
                const auto& Row = Item->AsArray();
                Result.Emplace(Row[0]->AsNumber(), Row[1]->AsNumber(), Row[2]->AsNumber());
            }
            return Result;
        };
        Asset->RestBody = ReadVectors(Input, TEXT("body"));
        Asset->ClothRestPositions = ReadVectors(Input, TEXT("cloth"));
        for (int32 Index = 0; Index < Asset->RestBody.Num(); ++Index) Asset->CanonicalToRender.Add(Index);
        for (const auto& Index : Input->GetArrayField(TEXT("quads"))) Asset->BodyQuads.Add(int32(Index->AsNumber()));
        for (const auto& Index : Input->GetArrayField(TEXT("cloth_triangles"))) Asset->ClothTriangles.Add(int32(Index->AsNumber()));
        Asset->ClothUVs.Init(FVector2D::ZeroVector, Asset->ClothRestPositions.Num());
        if (!TestTrue(TEXT("Fresh native M>N Bake"), BakeHUMANativeLOD(*Asset, {}, {},
            float(Input->GetNumberField(TEXT("sigma_min"))), float(Input->GetNumberField(TEXT("distance_scale"))), Error)))
        { AddError(Error + Asset->BakeStatus); return false; }
        TestTrue(TEXT("M>N fixture"), Asset->AnchorTriangles.Num() > Asset->ClothRestPositions.Num());
        for (const auto& PoseValue : Input->GetArrayField(TEXT("poses")))
        {
            TArray<FVector3f> Body;
            for (const FVector& Position : ReadVectors(PoseValue->AsObject(), TEXT("body"))) Body.Add(FVector3f(Position));
            TArray<FVector> Expected, Actual;
            if (!Asset->Evaluate(Body, Expected, Error)) { AddError(Error); return false; }
            const auto State = MakeShared<FHUMAClothGpuState, ESPMode::ThreadSafe>(*Asset);
            ENQUEUE_RENDER_COMMAND(HUMAFieldGPUCountTest)([State, Body, &Actual](FRHICommandListImmediate& RHICmdList)
            {
                FRDGBuilder Graph(RHICmdList);
                const auto Static = PrepareBuffers(Graph, *State);
                const auto BodyBuffer = CreateVertexBuffer(Graph, TEXT("HUMAFieldTest.Body"),
                    FRDGBufferDesc::CreateBufferDesc(4, Body.Num() * 3), Body.GetData(), Body.Num() * sizeof(FVector3f));
                const auto Normals = Graph.CreateBuffer(FRDGBufferDesc::CreateStructuredDesc(12, Body.Num()), TEXT("HUMAFieldTest.Normals"));
                const auto Anchors = Graph.CreateBuffer(FRDGBufferDesc::CreateStructuredDesc(12, State->Bary.Num() * 4), TEXT("HUMAFieldTest.Anchors"));
                const auto Positions = Graph.CreateBuffer(FRDGBufferDesc::CreateBufferDesc(4, State->Rest.Num() * 3), TEXT("HUMAFieldTest.Positions"));
                FRHIGPUBufferReadback Readback(TEXT("HUMAFieldTest.Readback"));
                for (int32 Pass = 0; Pass < 3; ++Pass)
                {
                    auto* Parameters = Graph.AllocParameters<FHUMAClothSoftBindCS::FParameters>();
                    Parameters->BodyCount = Body.Num(); Parameters->AnchorCount = State->Bary.Num();
                    Parameters->ClothCount = State->Rest.Num(); Parameters->Slots = State->Slots;
                    Parameters->BodyPositions = Graph.CreateSRV(BodyBuffer, PF_R32_FLOAT);
                    Parameters->Mapping = Graph.CreateSRV(Static[0]); Parameters->Quads = Graph.CreateSRV(Static[1]);
                    Parameters->BodyOffsets = Graph.CreateSRV(Static[2]); Parameters->BodyIncidents = Graph.CreateSRV(Static[3]);
                    Parameters->AnchorTriangles = Graph.CreateSRV(Static[4]); Parameters->Bary = Graph.CreateSRV(Static[5]);
                    Parameters->Rest = Graph.CreateSRV(Static[6]); Parameters->RestPosition = Graph.CreateSRV(Static[7]);
                    Parameters->RestTangent = Graph.CreateSRV(Static[8]); Parameters->RestBitangent = Graph.CreateSRV(Static[9]);
                    Parameters->RestNormal = Graph.CreateSRV(Static[10]);
                    Parameters->InfluenceAnchors = Graph.CreateSRV(Static[11]); Parameters->InfluenceWeights = Graph.CreateSRV(Static[12]);
                    Parameters->BodyNormals = Graph.CreateSRV(Normals); Parameters->Anchors = Graph.CreateSRV(Anchors);
                    Parameters->OutBodyNormals = Graph.CreateUAV(Normals); Parameters->OutAnchors = Graph.CreateUAV(Anchors);
                    Parameters->OutPositions = Graph.CreateUAV(Positions, PF_R32_FLOAT);
                    FHUMAClothSoftBindCS::FPermutationDomain Permutation;
                    Permutation.Set<FHUMAClothSoftBindCS::FPass>(Pass);
                    TShaderMapRef<FHUMAClothSoftBindCS> Shader(GetGlobalShaderMap(GMaxRHIFeatureLevel), Permutation);
                    ClearUnusedGraphResources(Shader, Parameters);
                    const uint32 Count = Pass == 0 ? Body.Num() : Pass == 1 ? State->Bary.Num() : State->Rest.Num();
                    FComputeShaderUtils::AddPass(Graph, RDG_EVENT_NAME("HUMAFieldTest Pass %d", Pass), Shader,
                        Parameters, FComputeShaderUtils::GetGroupCount(Count, 256));
                }
                const uint32 Bytes = State->Rest.Num() * sizeof(FVector3f);
                AddEnqueueCopyPass(Graph, &Readback, Positions, Bytes);
                Graph.Execute();
#if ENGINE_MINOR_VERSION >= 8
                RHICmdList.SubmitAndBlockUntilGPUIdle();
#else
                RHICmdList.BlockUntilGPUIdle();
#endif
                const auto* Points = static_cast<const FVector3f*>(Readback.Lock(Bytes));
                for (int32 Index = 0; Index < State->Rest.Num(); ++Index) Actual.Add(FVector(Points[Index]));
                Readback.Unlock();
            });
            FlushRenderingCommands();
            TestEqual(TEXT("GPU writes N garment vertices"), Actual.Num(), Expected.Num());
            double Maximum = 0;
            for (int32 Index = 0; Index < FMath::Min(Actual.Num(), Expected.Num()); ++Index)
                Maximum = FMath::Max(Maximum, (Actual[Index] - Expected[Index]).GetAbsMax());
            TestTrue(TEXT("M>N mixed-face GPU/CPU error < 3e-5 cm"), Maximum < 3.e-5);
            AddInfo(FString::Printf(TEXT("M=%d N=%d GPU/CPU max component error %.9g cm"),
                State->Bary.Num(), State->Rest.Num(), Maximum));
        }
    }
    if (!Tested) AddError(TEXT("Fixture has no require_m_gt_n case."));
    return Tested;
}
